# No environment variables are required for the zero-paid-service Docker path.
# These local defaults are shown for clarity and may be overridden.
NEXT_PUBLIC_SITE_URL=https://marketplace-label-normalizer.onrender.com
PUBLIC_HTTP_PORT=8080
CADDYFILE_PATH=./infra/Caddyfile
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
DATABASE_URL=postgresql+psycopg://labels:labels@postgres:5432/labels
POSTGRES_PASSWORD=labels
VALKEY_URL=redis://valkey:6379/0
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=/var/lib/label-normalizer
MAX_FILE_BYTES=26214400
MAX_BATCH_DOCUMENTS=20
MAX_PDF_PAGES=200
PROCESSING_TIMEOUT_SECONDS=120
TEMP_FILE_TTL_SECONDS=3600
WORKER_CONCURRENCY=2

# Authentication works zero-config through PostgreSQL, Valkey, and local Mailpit.
# The development secret is intentionally refused when ENVIRONMENT=production.
ENVIRONMENT=development
AUTH_API_INTERNAL_URL=http://api:8000
APP_PUBLIC_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXY_COUNT=0
AUTH_SECRET=dev-only-insecure-auth-secret-change-me
AUTH_COOKIE_PREFIX=ln
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_SECONDS=43200
AUTH_SESSION_ABSOLUTE_SECONDS=2592000
AUTH_SESSION_TOUCH_SECONDS=60
AUTH_MAX_SESSIONS_PER_USER=20
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_PASSWORD_MAX_BYTES=1024
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_PARALLELISM=2
AUTH_REQUIRE_VERIFIED_EMAIL=false
AUTH_VERIFICATION_TOKEN_TTL_SECONDS=86400
AUTH_RESET_TOKEN_TTL_SECONDS=1800
AUTH_AUDIT_STORE_IP_PREFIX=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TIMEOUT_SECONDS=0.25
RATE_LIMIT_LOGIN_IP_MAX=30
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_IP_MAX=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_EMAIL_IP_MAX=10
RATE_LIMIT_EMAIL_ACCOUNT_MAX=5
RATE_LIMIT_EMAIL_WINDOW_SECONDS=3600
RATE_LIMIT_RESET_IP_MAX=20
RATE_LIMIT_RESET_WINDOW_SECONDS=3600
EMAIL_PROVIDER=auto
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM_ADDRESS=no-reply@label-normalizer.local
EMAIL_FROM_NAME=Label Normalizer
MAX_JSON_BODY_BYTES=16384

# Optional hosted database (replace DATABASE_URL with a private Neon pooled URL).
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# Optional private temporary ImageKit storage. Blank values disable it.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

# Optional Phase 10 providers. Blank values disable them and never block boot.
AI_ENABLED=false
LOCAL_VISION_ENABLED=false
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
GEMINI_MODEL=gemini-3.6-flash
VISION_MAX_IMAGE_BYTES=5242880
VISION_AUTO_APPROVE_CONFIDENCE=0.85
